{
  "uid": "docker-containers",
  "title": "Docker Containers",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage % per Container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name)(rate(container_cpu_usage_seconds_total{image!=\"\"}[1m])) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list"},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage per Container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name)(container_memory_usage_bytes{image!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "B"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list"},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "type": "timeseries",
      "title": "Network Traffic per Container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name)(rate(container_network_receive_bytes_total{image!=\"\"}[1m]))",
          "legendFormat": "RX {{name}}",
          "refId": "C"
        },
        {
          "expr": "sum by (name)(rate(container_network_transmit_bytes_total{image!=\"\"}[1m]))",
          "legendFormat": "TX {{name}}",
          "refId": "D"
        }
      ],
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes/sec",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list"},
        "tooltip": {"mode": "single"}
      }
    }
  ]
}
